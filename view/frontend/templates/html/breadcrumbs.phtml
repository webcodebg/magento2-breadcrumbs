/** @var \Magento\Theme\Block\Html\Breadcrumbs $block */
/** @var \Magento\Framework\Escaper $escaper */

$viewModel = $block->getViewModel();
$crumbs = $viewModel->getBreadcrumbs();
?>

<?php if ($crumbs && is_array($crumbs)) : ?>
    <div class="breadcrumbs">
        <ul class="items">
            <?php foreach ($crumbs as $crumbName => $crumbInfo) : ?>
                <li class="item <?= /* @escapeNotVerified */ $crumbName ?>">
                    <?php if ($crumbInfo['link']) : ?>
                        <a href="<?= /* @escapeNotVerified */ $crumbInfo['link'] ?>" title="<?= $escaper->escapeHtml($crumbInfo['title']) ?>"><?= $escaper->escapeHtml($crumbInfo['label']) ?></a>
                    <?php else: ?>
                        <?= $escaper->escapeHtml($crumbInfo['label']) ?>
                    <?php endif; ?>
                </li>
            <?php endforeach; ?>
        </ul>
    </div>
<?php endif; ?>

<?php if ($json = $viewModel->getBreadcrumbsJsonLd()) : ?>
<script type="application/ld+json"><?= /* @noEscape */ $json; ?></script>
<?php endif; ?>
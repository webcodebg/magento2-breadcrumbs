<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- The cached primary_category options follow the category tree: names and paths. -->
    <event name="catalog_category_save_after">
        <observer name="webcode_breadcrumbs_clear_primary_category_options"
                  instance="Webcode\Breadcrumbs\Observer\ClearPrimaryCategoryOptions"/>
    </event>
    <event name="catalog_category_delete_after">
        <observer name="webcode_breadcrumbs_clear_primary_category_options"
                  instance="Webcode\Breadcrumbs\Observer\ClearPrimaryCategoryOptions"/>
    </event>
    <event name="catalog_category_move_after">
        <observer name="webcode_breadcrumbs_clear_primary_category_options"
                  instance="Webcode\Breadcrumbs\Observer\ClearPrimaryCategoryOptions"/>
    </event>
</config>
